# Loaded automatically by Vite/Vitest for mode "test" (vitest's default mode).
#
# Stands in for the build-time RPC + WS endpoints (see vite.config.ts's
# injectCsp and lib/chain/pins.ts) so the unit tests exercise
# the real getConnection() path instead of hitting the "no RPC
# configured" fallback, AND so the build-level CSP regression test (see
# src/lib/cspPolicy.test.ts) builds a representative bundle with
# both origins present. Mirrors web/.env.test. Individual
# tests that need the genuinely-unset case override this back to "" via
# vi.stubEnv (see pins.test.ts).
VITE_SOLANA_RPC_URL=http://localhost:8899
VITE_SOLANA_WS_URL=ws://localhost:8900
