# Loaded automatically by Vite/Vitest for mode "test" (vitest's default mode).
#
# Stands in for the build-time Solana RPC + WS endpoints (see vite.config.ts's
# injectCsp and lib/chain.ts) so the Solana-branch unit tests exercise the
# real getConnection()/Connection path instead of hitting the "no RPC
# configured" guard, AND so the build-level CSP regression test (see
# cspPolicy.test.ts) builds a representative Solana-shaped bundle with both
# origins present. Matches the RPC_URL/publicRpcUrl fixtures the Solana specs
# already used before VITE_SOLANA_RPC_URL replaced the runtime config.
VITE_SOLANA_RPC_URL=http://localhost:8899
VITE_SOLANA_WS_URL=ws://localhost:8900
